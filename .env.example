# ==========================================
# إعدادات تطبيق البيت (Bayti Kitchen)
# ==========================================

# المنفذ وبيئة التشغيل (في Railway يتم ضبط PORT تلقائياً)
PORT=8080
APP_ENV=production # 'development' أو 'production'

# ─── نوع قاعدة البيانات ───
# عند تشغيل PostgreSQL على Railway، يتم تلقائياً تزويد الرابط DATABASE_URL
# وسيتصل الخادم تلقائياً بقاعدة بيانات Postgres
DB_TYPE=postgres

# رابط اتصال PostgreSQL الكامل (يوفره Railway تلقائياً كـ Variable)
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# إعدادات PostgreSQL الفردية (في حال عدم استخدام DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=railway
DB_SSLMODE=disable

# مسار مجلد تخزين الصور والمرفقات (ربطه مع Volume في Railway على /app/uploads)
UPLOAD_DIR=/app/uploads

# مسار ملفات الواجهة الأمامية المجمعة (SPA)
STATIC_DIR=/app/dist

# الأمان و CORS
JWT_SECRET=super-secret-bayti-kitchen-key-2026
CORS_ORIGIN=*

# عنوان API في الواجهة الأمامية (اختياري - يكتشف النطاق تلقائياً عند النشر)
# VITE_API_BASE_URL=https://your-app.up.railway.app/api
