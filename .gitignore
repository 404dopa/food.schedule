# Databases & SQLite files (Strictly ignored - never commit database files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
bayti_kitchen.db
backend/bayti_kitchen.db
*.db.bak

# Executables & Binaries
*.exe
*.exe~
bayti-server
backend/server.exe
backend/bayti-server
backend/bin/

# Environment configuration files (Strictly ignored - never commit real secrets)
.env
.env.*
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Dependencies
node_modules/
frontend/node_modules/
vendor/

# Build artifacts
dist/
frontend/dist/
build/
.vite/
frontend/.vite/

# Uploaded media & Volume storage (keep folder with .gitkeep)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
tmp/
temp/

# OS generated files
.DS_Store
Thumbs.db

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
